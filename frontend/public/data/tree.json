  "synthesis_nodes": [
    {
      "id": "synthesis-therapeutic-moral",
      "label": "Temporal Integration",
      "contributing_claims": ["D04", "D07", "M03", "M13"],
      "synthesis_text": "Both therapeutic dissolution (after harm) and moral action (during/before harm) can coexist. The apparent contradiction dissolves when we recognize they operate in different temporal frames: understanding serves healing; judgment serves prevention.",
      "position": { "x": 0, "y": 200 }
    },
    {
      "id": "synthesis-middle-path",
      "label": "Middle Path Ethics",
      "contributing_claims": ["D05", "M04", "M09"],
      "synthesis_text": "Between complete relativism and rigid absolutism lies a middle path that acknowledges contextual factors while maintaining that certain acts (intentional torture of innocents) remain wrong across contexts. Moral evolution suggests movement toward this integration.",
      "position": { "x": 200, "y": 200 }
    }
  ],
  "semantic_drift": [
    {
      "term": "evil",
      "marcus_meaning": "A real force in the cosmos that works to separate beings from love; something that objectively exists and can be identified through embodied knowing",
      "demartini_meaning": "A label we apply to events when we fail to see their benefits; an epistemological error rather than an ontological reality",
      "affected_claims": ["D01", "D02", "M01", "M07", "M09"]
    },
    {
      "term": "understanding",
      "marcus_meaning": "Comprehending why something happened while still maintaining that it was wrong; compatible with moral judgment",
      "demartini_meaning": "Seeing both sides of an event until the label of 'evil' dissolves; incompatible with maintaining moral judgment",
      "affected_claims": ["D07", "M12", "M13"]
    },
    {
      "term": "morality",
      "marcus_meaning": "Embodied knowledge of right and wrong that transcends culture; sacred obligations that arise from our participation in the divine",
      "demartini_meaning": "Culturally constructed rules that evolve from primitive amygdala reactions to sophisticated relativism; situational rather than absolute",
      "affected_claims": ["D03", "D05", "M01", "M04", "M10"]
    }
  ],
