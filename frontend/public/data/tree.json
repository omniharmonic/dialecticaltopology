    {
      "id": "synthesis-therapeutic-moral",
      "label": "Temporal Integration",
      "contributing_claims": ["D04", "D07", "M03", "M13"],
      "synthesis_text": "Both therapeutic dissolution (after harm) and moral action (during/before harm) can coexist. The apparent contradiction dissolves when we recognize they operate in different temporal frames: understanding serves healing; judgment serves prevention.",
      "position": { "x": 0, "y": 200 }
    },
    {
      "id": "synthesis-middle-path",
      "label": "Middle Path Ethics",
      "contributing_claims": ["D05", "M04", "M09"],
      "synthesis_text": "Between complete relativism and rigid absolutism lies a middle path that acknowledges contextual factors while maintaining that certain acts (intentional torture of innocents) remain wrong across contexts. Moral evolution suggests movement toward this integration.",
      "position": { "x": 200, "y": 200 }
    }
  ],
